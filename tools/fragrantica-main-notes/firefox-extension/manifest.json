{
  "manifest_version": 2,
  "name": "Shobi Fragrantica Main Notes Collector",
  "version": "0.2.1",
  "description": "Captures Fragrantica Main Notes from normal Firefox browsing and forwards them to the local GitHub runner bridge.",
  "permissions": [
    "storage",
    "tabs",
    "downloads",
    "https://www.fragrantica.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.fragrantica.com/perfume/*"],
      "js": ["bridge-content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "Shobi Main Notes Collector"
  },
  "web_accessible_resources": [
    "page-catcher.js"
  ]
}
