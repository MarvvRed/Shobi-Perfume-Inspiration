{
  "manifest_version": 2,
  "name": "Shobi Fragrantica Main Notes Collector",
  "version": "0.3.2",
  "description": "Handles both Show votes and already-visible Hide votes states, ranks ingredient notes by user votes, and saves the top five.",
  "permissions": ["storage","tabs","downloads","https://fragrantica.com/*","https://www.fragrantica.com/*","https://*.fragrantica.com/*","http://127.0.0.1:8765/*"],
  "background": {"scripts":["background.js"]},
  "content_scripts": [{"matches":["https://fragrantica.com/*","https://www.fragrantica.com/*","https://*.fragrantica.com/*"],"js":["bridge-content.js"],"run_at":"document_start","all_frames":false}],
  "browser_action":{"default_title":"Shobi Main Notes Collector"},
  "web_accessible_resources":["page-catcher.js"]
}
